# Example for Google Gemini:
MODEL=gemini/gemini-3.5-flash
API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
BASE_URL=

# Example for an OpenAI-compatible provider
# MODEL=openai/gpt-4o-mini
# API_KEY=
# BASE_URL=

# Examples:
# OpenRouter:
# MODEL=openai/your-model-slug
# BASE_URL=https://openrouter.ai/api/v1
#
# Ollama:
# MODEL=ollama/your-installed-model
# BASE_URL=http://localhost:11434

# Optional LLM transient retry configuration (503 / 429 / 5xx / network timeouts)
# LLM_MAX_ATTEMPTS=5
# LLM_RETRY_INITIAL_DELAY=2.0
# LLM_RETRY_MAX_DELAY=30.0
